# Required. The password for posting (iOS Shortcut) and editing (/admin).
# Make it long and random: openssl rand -hex 24
JOURNAL_SECRET=change-me-to-a-long-random-string

# Auto-injected by Vercel when you connect a Blob store.
# For local dev, run: vercel env pull .env.local
BLOB_READ_WRITE_TOKEN=

# Everything below is optional cosmetics (NEXT_PUBLIC_ vars are baked in at
# build time, so changing them requires a redeploy).
NEXT_PUBLIC_SITE_TITLE=trackl0g
NEXT_PUBLIC_SITE_TAGLINE=a public log of songs that altered my brain chemistry
NEXT_PUBLIC_ABOUT=
NEXT_PUBLIC_TIMEZONE=America/New_York
NEXT_PUBLIC_EMBED_PLAYERS=false
NEXT_PUBLIC_SITE_URL=
